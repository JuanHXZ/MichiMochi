PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# Security (use strong random values in production, min 32 chars for JWT_SECRET)
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_PEPPER=

# CORS (comma-separated origins, no wildcard * or localhost in production)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:8081
ENABLE_API_DOCS=true

# Persistence (postgres required in production / AWS RDS)
PERSISTENCE_MODE=postgres
DATABASE_URL=postgres://michimochi:michimochi@localhost:5432/michimochi
DATABASE_SSL=false

# Firebase Auth (Identity Provider)
FIREBASE_PROJECT_ID=michimochiapp
FIREBASE_API_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email (resend required in production; console allowed only in dev/test)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=MichiMochi <no-reply@michimochi.com>

# AWS S3 Catalog Media
AWS_REGION=us-east-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=
